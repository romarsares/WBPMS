# -----------------------------------------------------------------------
# WBPMS — InfinityFree Environment Template
#
# 1. Copy this file to .env (remove the .infinityfree extension).
# 2. Fill in every placeholder marked with <REPLACE_...>.
# 3. Upload .env to the root htdocs/ directory of your hosting account.
# 4. NEVER commit .env to version control or share it publicly.
# -----------------------------------------------------------------------

# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------

APP_ENV=production
APP_DEBUG=false

# Set this to your actual InfinityFree subdomain or custom domain.
# Examples:
#   APP_BASE_URL=https://yourdomain.free.nf
#   APP_BASE_URL=https://yourcustomdomain.com
APP_BASE_URL=https://<REPLACE_YOUR_DOMAIN>

# Generate a random 32+ character secret key.
# You can generate one locally with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=<REPLACE_WITH_32_CHAR_RANDOM_SECRET>

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
#
# IMPORTANT: InfinityFree database host is NOT "localhost" or "127.0.0.1".
# It is a specific hostname shown in your InfinityFree members area under:
#   Hosting Account → Manage → MySQL Databases → Database Details
#
# The hostname looks like: sql<NUMBER>.infinityfree.com
# Example: sql200.infinityfree.com
#
# DB_NAME and DB_USER also have a prefix based on your account username,
# e.g. if your username is "epiz_12345678", your database name will be
# "epiz_12345678_wbpms" and user will be "epiz_12345678".
# Check the exact values in your InfinityFree control panel.

DB_HOST=<REPLACE_WITH_INFINITYFREE_MYSQL_HOST>
DB_PORT=3306
DB_NAME=<REPLACE_WITH_YOUR_DATABASE_NAME>
DB_USER=<REPLACE_WITH_YOUR_DATABASE_USER>
DB_PASSWORD=<REPLACE_WITH_YOUR_DATABASE_PASSWORD>

# -----------------------------------------------------------------------
# Testing database — not used on InfinityFree (no CLI access).
# Leave these blank or remove them; they are only needed locally.
# -----------------------------------------------------------------------
TEST_DB_HOST=
TEST_DB_PORT=3306
TEST_DB_NAME=
TEST_DB_USER=
TEST_DB_PASSWORD=

# -----------------------------------------------------------------------
# Mail / SMTP
# -----------------------------------------------------------------------
#
# InfinityFree does NOT provide an email server. You must use an external
# SMTP provider. Free options include Brevo (formerly Sendinblue), Gmail
# App Passwords, or Mailgun sandbox.
#
# Set MAIL_DRIVER=log to write emails to storage/private/mail.log instead
# of actually sending them (safe default while you test the deployment).
#
# Once you have SMTP credentials, switch to MAIL_DRIVER=smtp.

MAIL_DRIVER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@<REPLACE_YOUR_DOMAIN>
MAIL_FROM_NAME=WBPMS
