# -----------------------------------------------------------------------
# WBPMS — Railway Environment Variable Checklist
#
# DO NOT upload this file to Railway. Railway does not use a .env file.
# Instead, go to your Railway service → Settings → Variables and add
# each key/value pair listed below manually.
#
# This file documents every variable that must be set for the application
# to run correctly on Railway, including password reset via email.
# -----------------------------------------------------------------------

# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------

APP_ENV=production

# Set this to your Railway public domain.
# Find it in Railway → your service → Settings → Networking → Public URL.
# Example: https://wbpms-production.up.railway.app
#
# IMPORTANT: This must be your Railway URL, NOT localhost.
# If this is wrong or missing, password reset links will use the request
# host as a fallback, but setting it explicitly is strongly recommended.
APP_BASE_URL=https://<YOUR_RAILWAY_DOMAIN>

# Generate a random 32+ character secret used for session signing.
# Generate one with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=<REPLACE_WITH_32_CHAR_RANDOM_SECRET>

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
#
# Railway provisions a MySQL service automatically. The values below are
# available in Railway → your MySQL service → Variables tab.
# The typical Railway variable names are shown on the left; map them to
# the WBPMS variable names on the right.
#
#   ${{MySQL.MYSQL_HOST}}     → DB_HOST
#   ${{MySQL.MYSQL_PORT}}     → DB_PORT
#   ${{MySQL.MYSQL_DATABASE}} → DB_NAME
#   ${{MySQL.MYSQL_USER}}     → DB_USER
#   ${{MySQL.MYSQL_PASSWORD}} → DB_PASSWORD

DB_HOST=<REPLACE_WITH_RAILWAY_MYSQL_HOST>
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASSWORD=<REPLACE_WITH_RAILWAY_MYSQL_PASSWORD>

# -----------------------------------------------------------------------
# Mail — required for password reset to work
# -----------------------------------------------------------------------
#
# Railway Pro allows outbound SMTP (ports 465/587 are not blocked).
# Use MAIL_DRIVER=smtp with a Gmail App Password.
#
# Steps to get a Gmail App Password:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to Google Account → Security → App Passwords.
#   3. Generate a new App Password (select "Mail" + "Other").
#   4. You get a 16-character password like: xxxx xxxx xxxx xxxx
#
# Paste the raw App Password WITHOUT surrounding quotes in Railway Variables:
#   Correct:   gimh myxv mbrq bkwp
#   Wrong:    "gimh myxv mbrq bkwp"
#
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<YOUR_GMAIL_ADDRESS>
MAIL_PASSWORD=<YOUR_16_CHAR_APP_PASSWORD_NO_QUOTES>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<YOUR_GMAIL_ADDRESS>
MAIL_FROM_NAME=WBPMS

# -----------------------------------------------------------------------
# Testing database — not used on Railway. Leave these blank.
# -----------------------------------------------------------------------
TEST_DB_HOST=
TEST_DB_PORT=3306
TEST_DB_NAME=
TEST_DB_USER=
TEST_DB_PASSWORD=
