{
    "name": "wbpms/wbpms",
    "description": "Web-Based Payroll Management System for Light Diamond Enterprises",
    "type": "project",
    "require": {
        "php": "^8.2",
        "phpoffice/phpspreadsheet": "^3.3",
        "robmorgan/phinx": "^0.16",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Wbpms\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        }
    },
    "minimum-stability": "stable"
}
