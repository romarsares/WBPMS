# -----------------------------------------------------------------------
# WBPMS Environment Configuration — PRODUCTION TEMPLATE
# Copy this file to .env and fill in your production values.
# NEVER commit .env to version control.
# -----------------------------------------------------------------------

# Application
APP_ENV=production
APP_BASE_URL=https://your-domain.com
# Generate a strong random 32+ character secret key:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=CHANGE-ME-TO-A-STRONG-RANDOM-SECRET

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wbpms
DB_USER=wbpms_user
DB_PASSWORD=CHANGE-ME-TO-A-STRONG-PASSWORD
