# ============================================================
# WBPMS Docker deployment environment
# Copy this to .env on the target server and fill in values.
# Never commit real credentials to version control.
# ============================================================

# Application
APP_ENV=production
APP_BASE_URL=https://wbpms.coreflow.business
APP_KEY=CHANGE_ME_TO_A_SECURE_32_CHAR_KEY!!

# Database — the app container connects to service name "db"
APP_FORCE_SECURE_COOKIE=true
DB_HOST=shared-mysql
DB_PORT=3306
DB_NAME=wbpms
DB_USER=wbpms
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Mail — set to "log" to write emails to storage/private/mail.log
MAIL_DRIVER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=WBPMS
