# -----------------------------------------------------------------------
# WBPMS Environment Configuration Template
# Copy to .env and fill in your local values.
# Never commit .env to version control.
# -----------------------------------------------------------------------

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8000
APP_KEY=change-me-to-a-32-char-random-secret!

# Database (development)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wbpms
DB_USER=wbpms_user
DB_PASSWORD=secret

# Database (testing — separate database required)
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_NAME=wbpms_test
TEST_DB_USER=wbpms_user
TEST_DB_PASSWORD=secret
