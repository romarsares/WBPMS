# -----------------------------------------------------------------------
# WBPMS Environment Configuration Template
# Copy to .env and fill in your local values.
# Never commit .env to version control.
# -----------------------------------------------------------------------

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8000
APP_KEY=change-me-to-a-32-char-random-secret!

# Database (development)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wbpms
DB_USER=wbpms_user
DB_PASSWORD=secret

# Database (testing — separate database required)
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_NAME=wbpms_test
TEST_DB_USER=wbpms_user
TEST_DB_PASSWORD=secret

# SMTP / Mail — used by the forgot-password reset-link email
# -----------------------------------------------------------------------
# MAIL_DRIVER selects the email transport:
#
#   log    — writes emails to storage/private/mail.log (default for local dev;
#            no external credentials needed)
#
#   smtp   — sends via a real SMTP server using MAIL_HOST, MAIL_PORT, etc.
#            Works for Gmail App Passwords and similar SMTP providers.
#            NOT recommended for Railway Hobby (SMTP ports are blocked).
#
#   resend — sends via the Resend REST API over HTTPS port 443.
#            Required for Railway Hobby deployment where SMTP is blocked.
#            Set RESEND_API_KEY to your Resend API key.
#            MAIL_HOST / MAIL_PORT / MAIL_USERNAME / MAIL_PASSWORD are
#            ignored by this driver.
#
# For local development, leave MAIL_DRIVER=log.
# For Railway production, set MAIL_DRIVER=resend and RESEND_API_KEY.
# -----------------------------------------------------------------------
MAIL_DRIVER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Gmail App Password note:
#   In a .env FILE — wrap the password in quotes so phpdotenv preserves spaces:
#     MAIL_PASSWORD="gimh myxv mbrq bkwp"
#   In Railway (or any hosting dashboard) — paste the raw value WITHOUT quotes:
#     MAIL_PASSWORD=gimh myxv mbrq bkwp
#   The application strips surrounding quotes automatically, so both work.
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=WBPMS

# Resend API key — required only when MAIL_DRIVER=resend.
# Obtain from: https://resend.com/api-keys
# Keep this value secret; never commit it to version control.
# For initial testing, MAIL_FROM_ADDRESS=onboarding@resend.dev works only
# when sending to your Resend-verified account email. For production use,
# verify your own sending domain at https://resend.com/domains.
RESEND_API_KEY=

# Railway deployment note:
#   Railway does not read a .env file. Set all variables above in:
#   Railway → your service → Settings → Variables
#   See .env.railway for the full variable checklist.
