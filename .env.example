# -----------------------------------------------------------------------
# WBPMS Environment Configuration Template
# Copy to .env and fill in your local values.
# Never commit .env to version control.
# -----------------------------------------------------------------------

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8000
APP_KEY=change-me-to-a-32-char-random-secret!

# Database (development)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wbpms
DB_USER=wbpms_user
DB_PASSWORD=secret

# Database (testing — separate database required)
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_NAME=wbpms_test
TEST_DB_USER=wbpms_user
TEST_DB_PASSWORD=secret

# SMTP (used by the forgot-password reset-link email)
# Set MAIL_DRIVER=smtp for live sending, or MAIL_DRIVER=log to write emails
# to storage/private/mail.log instead (useful for local dev without an SMTP server).
MAIL_DRIVER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Gmail App Password note:
#   In a .env FILE — wrap the password in quotes so phpdotenv preserves spaces:
#     MAIL_PASSWORD="gimh myxv mbrq bkwp"
#   In Railway (or any hosting dashboard) — paste the raw value WITHOUT quotes:
#     MAIL_PASSWORD=gimh myxv mbrq bkwp
#   The application strips surrounding quotes automatically, so both work.
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=WBPMS

# Railway deployment note:
#   Railway does not read a .env file. Set all variables above in:
#   Railway → your service → Settings → Variables
#   See .env.railway for the full variable checklist.
