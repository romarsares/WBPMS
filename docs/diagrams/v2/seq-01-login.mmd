sequenceDiagram
    participant User
    participant AuthController
    participant AuthService
    participant Database

    User->>AuthController: POST /login (email, password)
    AuthController->>AuthService: attemptLogin(email, password)
    AuthService->>Database: SELECT user WHERE email = ?
    Database-->>AuthService: User row or null

    alt Invalid credentials or Inactive
        AuthService->>Database: INSERT audit_logs (login_failure)
        AuthService-->>AuthController: null
        AuthController-->>User: Redirect /login with error
    else Unlinked Employee
        AuthService->>Database: INSERT audit_logs (login_failure)
        AuthService-->>AuthController: throw UnlinkedEmployeeException
        AuthController-->>User: Redirect /login with error
    else Valid
        AuthService->>Database: INSERT audit_logs (login_success)
        AuthService-->>AuthController: identity array
        AuthController->>AuthController: setIdentity / regenerate session
        alt Requires password change
            AuthController-->>User: Redirect /change-password
        else
            AuthController-->>User: Redirect to role dashboard
        end
    end
