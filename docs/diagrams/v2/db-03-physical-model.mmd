    contribution_policy_version_tbl ||--o{ contribution_record_tbl : "contribution_policy_id"
    payroll_tbl ||--o| payslip_tbl : "payroll_id"
    payroll_period_tbl ||--o| disbursement_batch_tbl : "payroll_period_id"
    employee_tbl ||--o{ bank_details_tbl : "employee_id"
