    employee_tbl ||--o{ salary_tbl : "employee_id"
    payroll_period_tbl ||--o{ payroll_run_tbl : "payroll_period_id"
    branch_tbl ||--o{ payroll_run_tbl : "branch_id"
    payroll_run_tbl ||--o{ payroll_tbl : "payroll_run_id"
    employee_tbl ||--o{ payroll_tbl : "employee_id"
    salary_tbl ||--o{ payroll_tbl : "salary_id"
    payroll_tbl ||--o{ deduction_tbl : "payroll_id"
